{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.1,
  "env": {
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5",
    "BASH_DEFAULT_TIMEOUT_MS": "180000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "MCP_SERVER_CONNECTION_BATCH_SIZE": "10",
    "MCP_TOOL_TIMEOUT": "60000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "ExitPlanMode",
      "mcp__brave-search__*",
      "mcp__tavily-remote__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_playwright_playwright__*"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm -rf *)",
      "Bash(git clean -fd*)",
      "Bash(chmod 777 *)",
      "Bash(npm publish*)",
      "Bash(pip install --user*)",
      "Edit(**/*credentials*)",
      "Edit(**/*password*)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(.git/**)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.development)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.secret*)"
    ],
    "ask": [
      "Read(**/*credentials*)",
      "Read(**/*password*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.kube/*)",
      "Bash(git rebase*)"
    ],
    "defaultMode": "plan"
  },
  "model": "claude-fable-5-1[1m]",
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "adr": "off",
    "agentic-notes": "off",
    "api-design": "off",
    "codex-changelog-review": "off",
    "devlog": "off",
    "excalidraw-diagram": "off",
    "github-actions": "off",
    "java-modern-patterns": "off",
    "jpa-patterns": "off",
    "learning-tracker": "off",
    "project-overview": "off",
    "python-code-style": "off",
    "python-patterns": "off",
    "python-testing": "off",
    "sns-writer": "off",
    "springboot-patterns": "off",
    "springboot-security": "off",
    "springboot-tdd": "off",
    "springboot-verification": "off",
    "sql-optimization-patterns": "off",
    "tech-blog-writer": "off",
    "til-tagger": "off",
    "translate-article": "off",
    "youtube-summarizer": "off",
    "find-docs": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/link-skills.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/model-context.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/omc-companion-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit-gate.sh",
            "if": "Bash(*git commit*)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-rm.sh",
            "if": "Bash(*rm *)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-rewriter.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/file-dispatcher.sh check",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/til-review.sh",
            "timeout": 400
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-linker.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/model-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'exec \"$HOME/.local/share/mise/shims/node\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)dist/index.js\"'"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "codex@openai-codex": true,
    "postman@claude-plugins-official": false,
    "temporal@temporal-marketplace": true,
    "slack@claude-plugins-official": false,
    "oh-my-claudecode@omc": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "temporal-marketplace": {
      "source": {
        "source": "github",
        "repo": "temporalio/claude-temporal-plugin"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "default",
  "language": "korean",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "생각하는 중",
      "분석하는 중",
      "추론하는 중",
      "원인 파악 중",
      "코드 읽는 중",
      "파일 탐색 중",
      "구조 파악 중",
      "의존성 파악 중",
      "의존성 추적 중",
      "패턴 찾는 중",
      "로직 따라가는 중",
      "스펙 확인 중",
      "설계하는 중",
      "최적화 중",
      "리팩토링 중",
      "예외 처리 중",
      "쿼리 튜닝 중",
      "마이그레이션 중",
      "디버깅 중",
      "에러 재현 중",
      "로그 까보는 중",
      "스택트레이스 뜯는 중",
      "트러블슈팅 중",
      "엣지케이스 보는 중",
      "삽질하는 중",
      "코드 리뷰 중",
      "PR 까보는 중",
      "컨플릭트 해결 중",
      "빌드 돌리는 중",
      "CI 기다리는 중",
      "배포하는 중",
      "롤백하는 중",
      "핫픽스 중",
      "테스트 돌리는 중",
      "검증하는 중"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tipsFile": "~/.claude/spinner-tips.json",
    "label": "내 팁"
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
