#:schema https://developers.openai.com/codex/config-schema.json
# Fresh-install defaults. Existing ~/.codex/config.toml also contains app-managed state.
# See .codex/README.md for the Astra setup and optional skill overrides.

model = "gpt-6-astra"
model_reasoning_effort = "high"
model_verbosity = "medium"
personality = "pragmatic"

# cdx selects workspace-write; cdx -y explicitly selects full access.
# Keep the fresh-install permission boundary independent of model tuning.
approval_policy = "on-request"
sandbox_mode = "read-only"
file_opener = "vscode"
web_search = "live"

# Use the active model's context window and auto-compaction defaults.
# No Sol-specific fixed threshold or custom compaction prompt.

[tools.update_plan]
enabled = true

[history]
persistence = "save-all"
max_bytes = 5242880

# Keep tools with a distinct workflow. Native web search covers general search;
# the alternate search MCPs remain configured for optional re-enablement.
[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

[mcp_servers.tavily-remote]
enabled = false
command = "sh"
args = ["-c", "if [ -f \"$HOME/.dotfiles/.env.local\" ]; then . \"$HOME/.dotfiles/.env.local\"; fi; exec npx -y mcp-remote \"https://mcp.tavily.com/mcp/?tavilyApiKey=$TAVILY_API_KEY\""]

[mcp_servers.brave-search]
enabled = false
command = "sh"
args = ["-c", "if [ -f \"$HOME/.dotfiles/.env.local\" ]; then . \"$HOME/.dotfiles/.env.local\"; fi; exec npx -y @brave/brave-search-mcp-server --transport stdio"]

[mcp_servers.youtrack]
command = "sh"
args = ["-c", "if [ -f \"$HOME/.dotfiles/.env.local\" ]; then . \"$HOME/.dotfiles/.env.local\"; fi; exec npx -y mcp-remote \"$YOUTRACK_URL/mcp\" --header \"Authorization:Bearer $YOUTRACK_TOKEN\""]

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[features]
unified_exec = true
multi_agent = true
hooks = true
goals = true
memories = true

[features.context_management]
experimental_mode = true

[skills]
config = [
    { path = "~/.dotfiles/.codex/skills/adr/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/api-design/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/find-docs/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/java-modern-patterns/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/jpa-patterns/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/project-overview/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/python-code-style/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/python-patterns/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/python-testing/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/skill-guide/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/springboot-patterns/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/springboot-security/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/springboot-tdd/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/springboot-verification/SKILL.md", enabled = false },
    { path = "~/.dotfiles/.codex/skills/sql-optimization-patterns/SKILL.md", enabled = false },
]

[tui]
notifications = false
animations = true
show_tooltips = true
status_line = ["model-with-reasoning", "current-dir", "git-branch", "context-remaining", "context-used", "five-hour-limit", "weekly-limit", "codex-version", "context-window-size"]
status_line_use_colors = true
